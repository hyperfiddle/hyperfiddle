(ns hyperfiddle.hfql2.analyzer.lambda
  (:require [hyperfiddle.rcf :refer [tests]]
            [clojure.spec.alpha :as s]))

(s/def ::fn-sym #{'fn `fn 'fn*})
(s/def ::name (s/nilable symbol?))
(s/def ::parameters (s/coll-of simple-symbol? :kind vector?))
(s/def ::body (s/nilable seq?))
(s/def ::arity (s/keys :req [::parameters ::body]))
(s/def ::arities (s/coll-of ::arity :kind vector?))
(s/def ::lambda (s/keys :req [::fn-sym ::name ::arities]))

(letfn [(parse-arity [[parameters & body]] {::parameters parameters, ::body body})]
  (defn- parse-lambda [form]
    {:post [(s/valid? ::lambda %)]}
    (let [[fn-sym ?name & arities] form
          [?name arities] (if (symbol? ?name) [?name arities] [nil (cons ?name arities)])]
      {::fn-sym fn-sym
       ::name ?name
       ::arities (if (seq? (first arities))
                   (mapv parse-arity arities)
                   (vector (parse-arity arities)))})))

(defn- parsed-lambda? [x] (s/valid? ::lambda x))
(defn- arity? [x] (s/valid? ::arity x))


(comment
  (anonymous? '(fn []))
  (parse-lambda '(fn []))
  (parse-lambda ''1)
  )

(comment
  (set! *print-namespace-maps* false)
  )

(tests
  (parse-lambda '(fn f [a] (inc a)))
  := '{:hyperfiddle.hfql2.analyzer.lambda/fn-sym fn,
       :hyperfiddle.hfql2.analyzer.lambda/name f,
       :hyperfiddle.hfql2.analyzer.lambda/arities
       [{:hyperfiddle.hfql2.analyzer.lambda/parameters [a],
         :hyperfiddle.hfql2.analyzer.lambda/body ((inc a))}]}

  (parse-lambda '(fn [a] (inc a)))
  := '{:hyperfiddle.hfql2.analyzer.lambda/fn-sym fn,
       :hyperfiddle.hfql2.analyzer.lambda/name nil,
       :hyperfiddle.hfql2.analyzer.lambda/arities
       [{:hyperfiddle.hfql2.analyzer.lambda/parameters [a],
         :hyperfiddle.hfql2.analyzer.lambda/body ((inc a))}]}

  (parse-lambda '#(inc %))
  := {:hyperfiddle.hfql2.analyzer.lambda/fn-sym 'fn*,
      :hyperfiddle.hfql2.analyzer.lambda/name nil,
      :hyperfiddle.hfql2.analyzer.lambda/arities
      [{:hyperfiddle.hfql2.analyzer.lambda/parameters [_],
        :hyperfiddle.hfql2.analyzer.lambda/body (list (list 'inc _))}]}

  )


(def arities ::arities)
(defn arity [index lambda] (nth (arities lambda) index nil))
(def parameters ::parameters)

;;; Detecting gensymed syms

;; Three variants:
;; - gensymed at runtime, with or without a user-provided prefix
;; - gensymed by the reader, via syntax quote
;; - gensymed by the reader, via sharp-lambda
(comment
  ;; runtime, no reader involved.
  (gensym) := 'G__163196
  (gensym "prefix") := 'prefix163206
  ;; syntax quote
  `a# := 'a__163443__auto__
  ;; sharp lambda
  '#(inc %) := (fn* [p1__163139#] (inc p1__163139#))
  '#(inc %1) := (fn* [p1__163144#] (inc p1__163144#))
  '#(inc %1 %2) := (fn* [p1__163156# p2__163157#] (inc p1__163156# p2__163157#))
  '#(inc %1 %2 %&) := (fn* [p1__163169# p2__163170# & rest__163171#] (inc p1__163169# p2__163170# rest__163171#))
  )

(defn- gensymed-by-clojure-reader? [?symbol]
  {:post [(boolean? %)]}
  (and (symbol? ?symbol)
    (or
      (some? (re-matches #"^.*__\d+__auto__$" (name ?symbol))) ; syntax quote
      (some? (re-matches #"^.*\d+#$" (name ?symbol))) ; any other ending by a number + #, supposedly generated by sharp lambda.
      )))

(tests
  ;; runtime
  (gensymed-by-clojure-reader? (gensym))
  := false

  (gensymed-by-clojure-reader? (gensym "prefix"))
  := false

  ;; syntax quote
  (gensymed-by-clojure-reader? `a#)
  := true

  ;; sharp lambda
  (symbol? (-> '#(inc %) second first))
  (gensymed-by-clojure-reader? (-> '#(inc %) second first))
  := true
  (gensymed-by-clojure-reader? (-> '#(inc %&) second second))
  := true
  )

(declare gensymed-from-sharp-lambda?)

(defn- gensymed-by-syntax-quote? [x]
  {:post [(boolean? %)]}
  (and (gensymed-by-clojure-reader? x)
    (not (gensymed-from-sharp-lambda? x))))

(tests
  (gensymed-by-syntax-quote? (gensym))
  := false

  (gensymed-by-syntax-quote? (gensym "prefix"))
  := false

  (gensymed-by-syntax-quote? `a#)
  := true

  (gensymed-by-syntax-quote? (-> '#(inc %) second first))
  := false
  )

(defn lambda? [form]
  {:post [(boolean? %)]}
  (if-not (seq? form)
    false
    (let [lambda (parse-lambda form)]
      (and
        (#{'fn `fn 'fn*} (::fn-sym lambda))
        (not (zero? (count (arities lambda))))))))

(tests
  (lambda? '(fn []))
  := true
  (lambda? '#())
  := true
  )

;;; Sharp lambda

(defn- gensymed-from-sharp-lambda? [x]
  {:post [(boolean? %)]}
  (and (gensymed-by-clojure-reader? x)
    (some? (re-matches #"^(p\d+|rest)__.*$" (name x))))) ; format is p1__123456789# or rest__123456789#

(tests
  (gensymed-from-sharp-lambda? (gensym))
  := false

  (gensymed-from-sharp-lambda? (gensym "prefix"))
  := false

  (gensymed-from-sharp-lambda? `a#)
  := false

  (gensymed-from-sharp-lambda? (-> '#(inc %) second first))
  := true

  (gensymed-from-sharp-lambda? (-> '#(inc %&) second second))
  := true
  )

(defn sharp-lambda? [form]
  {:post [(boolean? %)]}
  (and (lambda? form)
    (let [lambda (parse-lambda form)]
      (and
        (= 'fn* (::fn-sym lambda))
        (= 1 (count (arities lambda)))
        (every? gensymed-from-sharp-lambda? (remove #{'&} (parameters (arity 0 lambda))))))))

(tests
  (sharp-lambda? '#())
  := true
  (sharp-lambda? '#(do 1))
  := true
  (sharp-lambda? '#(inc 1))
  := true

  (sharp-lambda? '#(inc %))
  := true

  (sharp-lambda? '#(inc %&))
  := true

  (sharp-lambda? '(fn* [a] a))
  := false

  (sharp-lambda? `(fn* [a#] a#))
  := false

  (sharp-lambda? `(fn* [a#] a#))
  := false

  (sharp-lambda? `(fn* [~'%] ~'%))
  := false
  )

#?(:clj
   (tests
     (sharp-lambda? (macroexpand-1 '(fn [%] %)))
     := false
     ))

(defn anonymous? [lambda-form] (nil? (::name (parse-lambda lambda-form))))

(tests
  (anonymous? '(fn []))
  := true

  (anonymous? '(fn f []))
  := false
  )

(defn- largest-arity [lambda]
  {:pre [(parsed-lambda? lambda)]
   :post [(or (nil? %) (arity? %))]}
  (first (sort-by (comp count parameters) (arities lambda))))

(def penultimate (comp last butlast))

(defn variadic? [lambda-form]
  {:pre [(lambda? lambda-form)]
   :post [(boolean? %)]}
  (= '& (penultimate (parameters (largest-arity (parse-lambda lambda-form))))))

(tests
  (variadic? '#())
  := false
  (variadic? '#(inc %))
  := false
  (variadic? '#(apply + %&))
  := true
  )


(defn- find-arities-with-parameter* [lambda parameter]
  {:pre [(parsed-lambda? lambda)]
   :post [(every? arity? %)]}
  (filter #(contains? (disj (set (parameters %)) '&) parameter) (arities lambda)))

(defn find-arities-with-parameter
  [lambda-form symbolic-parameter]
  (find-arities-with-parameter* (parse-lambda lambda-form) symbolic-parameter))

(defn has-parameter? [lambda-form parameter]
  {:pre [(symbol? parameter)]
   :post [(boolean? %)]}
  (not (empty? (find-arities-with-parameter lambda-form parameter))))


(tests
  (has-parameter? '(fn []) 'x)
  := false
  (has-parameter? '(fn [x]) 'x)
  := true
  (has-parameter? '(fn ([]) ([x])) 'x)
  := true
  (has-parameter? '(fn ([]) ([x]) ([x y])) 'x)
  := true
  (has-parameter? '(fn ([]) ([x]) ([x y])) 'y)
  := true
  (has-parameter? '(fn ([]) ([x]) ([x y & z])) 'z)
  := true
  (has-parameter? '(fn ([]) ([x]) ([x y & z])) '&) ; & is not a parameter. It's syntax. Use `variadic?` instead.
  := false
  )