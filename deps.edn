{:hyperfiddle.build/name com.hyperfiddle/hyperfiddle
 :hyperfiddle.build/version "v0-alpha-SNAPSHOT"
 :hyperfiddle.build/pom-data [[:licenses
                               [:license
                                [:name "Hyperfiddle Business Source License"]
                                [:url "http://hyperfiddle.net"]]]
                              [:developers
                               [:developer
                                [:organization "Hyperfiddle, Inc."]
                                [:organizationUrl "http://www.hyperfiddle.net"]]]]
 :hyperfiddle.build/pom-scm {:url "https://github.com/hyperfiddle/hyperfiddle"
                             :connection "scm:git:git://github.com/hyperfiddle/hyperfiddle.git"
                             :developerConnection "scm:git:ssh://git@github.com/hyperfiddle/hyperfiddle.git"}

 :hyperfiddle/imported-demos {"../datomic-browser/src/dustingetz/datomic_browser2.cljc" "target/classes/dustingetz/datomic_browser2.cljc"}
 :deps/prep-lib {:alias :build :fn prep :ensure "target/classes"}
 :paths ["src" "resources" "target/classes"]

 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        com.hyperfiddle/electric {:local/root "../electric"}
        com.hyperfiddle/hyperfiddle-contrib {:local/root "../hyperfiddle-contrib"}

        com.hyperfiddle/heroicons-electric {:mvn/version "8a08de7"} ; for hyperfiddle.ui components
        instaparse/instaparse {:mvn/version "1.5.0"} ; EDNish
        }
 :aliases {:build {:extra-paths ["src-build"]
                   :ns-default  build
                   :extra-deps  {com.hyperfiddle/build {:local/root "../build"}}}
           :test {:extra-paths ["test"]
                  :exec-fn     hyperfiddle.test-runner/test
                  :exec-args   {:dir "src"
                                :patterns ["hyperfiddle.*"]
                                :exclude ["dustingetz\\.datomic-contrib2"
                                          "dustingetz\\.mbrainz"
                                          "dustingetz\\.nav-datomic"
                                          "dustingetz\\.pg-sakila"]}
                  :jvm-opts    ["-Dhyperfiddle.rcf.generate-tests=true"
                                "-XX:-OmitStackTraceInFastThrow"]
                  :extra-deps  {cider/cider-nrepl          {:mvn/version "0.58.0"} ; tested values match REPL's pretty-printed representation.
                                org.clojure/tools.namespace {:mvn/version "1.5.0"}
                                com.datomic/peer            {:mvn/version "1.0.7469"}}} ; nav-datomic, datomic-contrib2
           :release {:override-deps {com.hyperfiddle/electric {:mvn/version "v3-alpha-b5ceeefc9"}
                                     com.hyperfiddle/hyperfiddle-contrib {:mvn/version "v0-alpha-bcc21af7"}}}}}